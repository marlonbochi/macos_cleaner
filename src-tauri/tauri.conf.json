{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macOS Cleaner",
  "version": "0.1.0",
  "identifier": "com.marlonbochi.macoscleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "macOS Cleaner",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "Encontre e libere espa\u00e7o em disco com seguran\u00e7a",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
